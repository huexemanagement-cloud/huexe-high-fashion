# ==============================================================================
# HUEXE — High-Fashion Mother Agency & Studio CMS
# Environment Configuration Template
# ==============================================================================
# Copy this file to .env or .env.local and configure values for your environment.
# In production, ensure sensitive credentials are high-entropy and guarded.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE
# ------------------------------------------------------------------------------
# PostgreSQL connection string used by Drizzle ORM and node-postgres (pg.Pool).
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
# Example: postgresql://postgres:postgres@127.0.0.1:5432/app_db
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# ------------------------------------------------------------------------------
# 2. PUBLIC SITE METADATA
# ------------------------------------------------------------------------------
# Canonical URL for sitemap.xml, robots.txt, metadataBase, and OpenGraph images.
# In local development: http://localhost:3000
# In production: https://huexe.co
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 3. ADMINISTRATIVE ACCESS & INITIAL SEEDING
# ------------------------------------------------------------------------------
# Default credentials for the agency owner CMS portal (/admin/login).
# These are automatically seeded into the database on initial boot with 'owner' role.
#
# Production defaults:
# ADMIN_EMAIL=admin@huexe.co
# ADMIN_PASSWORD=Huexe#Admin2026!Global
ADMIN_EMAIL=admin@huexe.co
ADMIN_PASSWORD=Huexe#Admin2026!Global

# ------------------------------------------------------------------------------
# 4. SESSION SECURITY & CRYPTOGRAPHY
# ------------------------------------------------------------------------------
# Secret key used for cryptographic signing of CMS sessions and auth tokens.
# Generate a secure 64-character hex string in production: openssl rand -hex 32
SESSION_SECRET=huexe_atelier_master_session_secret_2026_super_confidential_key
